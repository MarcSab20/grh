<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="borderPane" prefHeight="700.0" prefWidth="1024.0" styleClass="root" stylesheets="@historique.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.historiqueController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="header">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <Label styleClass="title" text="Historique des événements" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="15.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <!-- Panel de filtres -->
            <VBox spacing="10.0" styleClass="filter-panel">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Label styleClass="section-title" text="Filtrer l'historique" />
                  <HBox spacing="20.0" alignment="CENTER_LEFT">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <Label text="Du:" />
                              <DatePicker fx:id="dateDebutPicker" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <Label text="Au:" />
                              <DatePicker fx:id="dateFinPicker" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <Label text="Action:" />
                              <ComboBox fx:id="actionFilterComboBox" prefWidth="150.0" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
                  <HBox spacing="10.0" alignment="CENTER_RIGHT">
                     <children>
                        <Button fx:id="rechercheButton" mnemonicParsing="false" text="Rechercher" styleClass="search-btn" />
                        <Button fx:id="resetButton" mnemonicParsing="false" text="Réinitialiser" styleClass="reset-btn" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <!-- Tableau d'historique -->
            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="actionColumn" text="Action" prefWidth="120.0" />
                  <TableColumn fx:id="cibleColumn" text="Cible" prefWidth="100.0" />
                  <TableColumn fx:id="detailsColumn" text="Détails" prefWidth="350.0" />
                  <TableColumn fx:id="dateTimeColumn" text="Date et heure" prefWidth="180.0" />
                  <TableColumn fx:id="utilisateurColumn" text="Utilisateur" prefWidth="150.0" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="footer">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <Button fx:id="backButton" mnemonicParsing="false" text="Retour à l'accueil" styleClass="back-btn" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
